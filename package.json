{
  "name": "einbuergerungstest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Offline-first study app for the German naturalization test (Einbürgerungstest), all 16 Bundesländer.",
  "license": "MIT",
  "homepage": "https://kailashbuki.github.io/einbuergerungstest/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kailashbuki/einbuergerungstest.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:i18n": "tsx scripts/lint-i18n.ts",
    "build:questions": "tsx scripts/build-questions.ts",
    "build:questions:offline": "tsx scripts/build-questions.ts --offline"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "autoprefixer": "^10.6.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "idb": "^8.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  }
